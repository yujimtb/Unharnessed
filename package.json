{
  "name": "unharnessed",
  "version": "0.1.0",
  "description": "An experimental Pi harness for ephemeral whispers, intrusive thoughts and divergent exploration",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/yujimtb/Unharnessed",
