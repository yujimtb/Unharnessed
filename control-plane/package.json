{
  "name": "unharnessed-control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit --pretty false && vite build",
    "check": "tsc --noEmit --pretty false",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@ag-ui/core": "0.0.59",
    "@ag-ui/encoder": "0.0.59",
    "@assistant-ui/react": "0.15.21",
    "@assistant-ui/react-ag-ui": "0.0.60",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "opik": "2.2.76",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vite": "8.3.0"
  }
}
