# Pi / OpenCodex
# PI_CODING_AGENT_DIR=C:\Users\you\.pi\agent
UNHARNESSED_MAIN_PROVIDER=opencodex
UNHARNESSED_MAIN_MODEL=gpt-5.5
UNHARNESSED_MAIN_THINKING=low

# Control plane ports
UNHARNESSED_CONTROL_HOST=127.0.0.1
UNHARNESSED_CONTROL_PORT=8787
UNHARNESSED_CONTROL_WEB_PORT=5174

# Jev
# JEV_API_KEY=...
# JEV_API_KEY_FILE=D:\path\to\jev_api_key.txt

# Opik self-hosted example
# OPIK_ENABLED=1
# OPIK_URL_OVERRIDE=http://127.0.0.1:5173/api
# OPIK_PROJECT_NAME=Unharnessed
# UNHARNESSED_OPIK_CONTROL_PROMPT=unharnessed-control

# Comet-hosted Opik additionally needs:
# OPIK_API_KEY=...
# OPIK_WORKSPACE=...
